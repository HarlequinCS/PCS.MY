# Enable Rewrite Engine
RewriteEngine On

# Base directory
# IMPORTANT: Change this based on your environment!
# For PRODUCTION (root domain): RewriteBase /
# For LOCAL (Laragon subdirectory): RewriteBase /pcs.my/

RewriteBase /

# Security: Disable directory browsing
Options -Indexes

# Security: Hide server information
ServerSignature Off

# Security: Prevent access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Handle trailing slashes - remove them
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Laravel-style clean URLs - serve .html files without extension
# Check if requested file doesn't exist, then try adding .html
# Exclude admin directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Alternative: If above doesn't work, try this simpler version
# Exclude admin directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.html$
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect .html requests to clean URLs (hides file extensions)
# But exclude admin directory and PHP files
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve index.html for root
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^$ index.html [L]

# Admin directory - allow PHP files
RewriteCond %{REQUEST_URI} ^/admin [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Default index files (check PHP first, then HTML)
DirectoryIndex index.php index.html index.htm

# Security: Prevent access to config files
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>
