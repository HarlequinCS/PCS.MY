# Enable Rewrite Engine
RewriteEngine On

# Base directory
# IMPORTANT: Toggle this based on your environment!
# For LOCALHOST (Laragon subdirectory): RewriteBase /pcs.my/
# For PRODUCTION (root domain): RewriteBase /

# LOCALHOST MODE (uncomment for local development)
# RewriteBase /pcs.my/

# PRODUCTION MODE (comment out above and uncomment below for production)
RewriteBase /

# Security: Disable directory browsing
Options -Indexes

# Security: Hide server information
ServerSignature Off

# Security: Prevent access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Redirect index.html to workshirt.html (301 permanent redirect)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ /workshirt.html [R=301,L]

# Redirect root (/) to workshirt.html (301 permanent redirect)
RewriteCond %{THE_REQUEST} \s/+\sHTTP [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^$ /workshirt.html [R=301,L]

# Handle trailing slashes - remove them
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Laravel-style clean URLs - serve .html files without extension
# Check if requested file doesn't exist, then try adding .html
# Exclude admin directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Alternative: If above doesn't work, try this simpler version
# Exclude admin directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.html$
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect .html requests to clean URLs (hides file extensions)
# But exclude admin directory, PHP files, and index.html (already redirected)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{REQUEST_URI} !^/index\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Internal rewrite: Serve workshirt.html for root if not already redirected
# This is a fallback in case redirects above don't catch it
RewriteCond %{REQUEST_URI} ^/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^$ /workshirt.html [L]

# Admin directory - allow PHP files
RewriteCond %{REQUEST_URI} ^/admin [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Default index files (check PHP first, then workshirt.html)
DirectoryIndex index.php workshirt.html index.html index.htm

# Security: Prevent access to config files
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>
