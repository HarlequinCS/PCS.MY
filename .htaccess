# Enable Rewrite Engine
RewriteEngine On

# Base directory
# IMPORTANT: Toggle this based on your environment!
# For LOCALHOST (Laragon subdirectory): RewriteBase /pcs.my/
# For PRODUCTION (root domain): RewriteBase /

# LOCALHOST MODE (uncomment for local development)
# RewriteBase /pcs.my/

# PRODUCTION MODE (comment out above and uncomment below for production)
RewriteBase /

# Security: Disable directory browsing
Options -Indexes

# Security: Hide server information
ServerSignature Off

# Security: Prevent access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Redirect /workshirt and /workshirt.html to / (301 permanent redirect)
RewriteCond %{THE_REQUEST} \s/+workshirt\.html[\s?] [NC]
RewriteRule ^workshirt\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+workshirt[\s?] [NC]
RewriteRule ^workshirt$ / [R=301,L]

# Handle trailing slashes - remove them
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Laravel-style clean URLs - serve .html files without extension
# Check if requested file doesn't exist, then try adding .html
# Exclude admin directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Alternative: If above doesn't work, try this simpler version
# Exclude admin directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.html$
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect .html requests to clean URLs (hides file extensions)
# But exclude admin directory, PHP files, and index.html (already redirected)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{REQUEST_URI} !^/index\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Admin directory - allow PHP files
RewriteCond %{REQUEST_URI} ^/admin [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Default index files
DirectoryIndex index.php index.html index.htm

# Security: Prevent access to config files
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================
# PERFORMANCE OPTIMIZATION - CACHE HEADERS
# ============================================

# Enable compression for text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching - CSS and JavaScript (1 year)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache static assets (CSS, JS, Images) for 1 year
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Cache HTML files for 1 hour (shorter cache for dynamic content)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    
    # Don't cache PHP files (dynamic content)
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    
    # Content Security Policy (adjust as needed for your site)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://dev.toyyibpay.com https://toyyibpay.com; frame-ancestors 'self';"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy (restrict browser features)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Strict Transport Security (HTTPS only - uncomment when using HTTPS)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
